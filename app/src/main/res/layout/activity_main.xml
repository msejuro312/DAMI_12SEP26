<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_servicego"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Punto de partida visual:
             en clase se agregarán aquí el encabezado, el formulario y la vista previa. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel_hero"
            android:padding="@dimen/card_padding">


            <TextView
                android:id="@+id/textViewTituloPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_principal"
                android:textColor="@color/blanco"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textViewSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_principal"
                android:layout_marginTop="8dp"
                android:textColor="@color/blanco_suave"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_panel"
            android:padding="@dimen/card_padding">


            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seccion_formulario"
                android:textColor="@color/azul_oscuro"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_cliente"
                android:layout_marginTop="6dp"
                android:textColor="@color/gris_texto"
                android:textSize="14sp"
                android:textStyle="bold"/>
            
            <EditText

                android:id="@+id/editTextCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:hint="@string/hint_cliente"
                android:inputType="textCapWords"
                android:minHeight="56dp"
                android:padding="@dimen/field_padding"
                android:textColor="@color/azul_oscuro"
                android:textColorHint="@color/gris_hint"/>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
